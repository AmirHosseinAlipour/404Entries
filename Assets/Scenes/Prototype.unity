    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[6].dialogues.Array.data[0]'
      value: "\u0641\u0642\u0637 \u0628\u06AF\u0648 \u0627\u0633\u062A\u0627\u062F
        \u0628\u0639\u062F\u06CC \u06A9\u06CC\u0647\u061F\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[6].dialogues.Array.data[1]'
      value: "\u0639\u062F\u06CC \u0627\u0633\u062A\u0627\u062F \u0627\u0633\u0642\u0627\u06CC\u06CC\u060C
        \u062F\u0631 \u06A9\u0644\u0627\u0633\u06F1\u06F1\u06F2 \u0645\u0634\u063A\u0648\u0644
        \u062A\u062F\u0631\u06CC\u0633 \n\u0647\u0633\u062A\u0646.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[6].dialogues.Array.data[2]'
      value: "\u062D\u0644\u0647 \u067E\u0633 \u0645\u0646 \u0631\u0641\u062A\u0645.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[6].dialogues.Array.data[3]'
      value: "\u0641\u0642\u0637 \u06CC\u0647 \u0686\u06CC\u0632\u06CC\u060C \u0627\u06CC\u0634\u0648\u0646
        \u06CC\u06A9\u0645\u06CC \u062D\u0633\u0627\u0633\u0646 \u06A9\u0647 \u0633\u0631
        \u06A9\u0644\u0627\u0633\n \u0645\u0632\u0627\u062D\u0645\u0634\u0648\u0646
        \u0628\u0634\u06CC\u060C \u0628\u0627\u06CC\u062F \u062F\u0632\u062F\u06A9\u06CC
        \u0628\u0631\u06CC \u0645\u062F\u0631\u06A9\u062A\u0648 \u0628\u0631\u062F\u0627\u0631\u06CC."
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[6].dialogues.Array.data[4]'
      value: "\u0645\u06AF\u0647 \u0642\u0631\u0627\u0631 \u0646\u0628\u0648\u062F
        \u0641\u0642\u0637 \u0642\u0628\u0648\u0644\u06CC \u062A\u0648 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647
        \u0633\u062E\u062A \u0628\u0627\u0634\u0647\u061F \n\u067E\u0633 \u0627\u06CC\u0646
        \u062B\u0628\u062A \u0646\u0627\u0645\u0634 \u0686\u06CC \u0645\u06CC\u06AF\u0647:((("
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[6].dialogues.Array.data[5]'
      value: "\u062D\u0627\u0644\u0627 \u0628\u0630\u0627\u0631 \u0628\u0639\u062F\u0634\u0648
        \u0628\u0628\u06CC\u0646\u06CC:)))\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[0]'
      value: " \u062E\u0628 \u062F\u06CC\u06AF\u0647\u2026\u062A\u0645\u0648\u0645
        \u0634\u062F \u062F\u06CC\u06AF\u0647 \u0622\u0631\u0647\u061F"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[1]'
      value: "\u0628\u0630\u0627\u0631 \u06CC\u0647 \u0646\u06AF\u0627\u0647 \u0628\u0646\u062F\u0627\u0632\u0645\u2026.
        \u0627\u0648\u0647. \u0628\u062F\u0628\u062E\u062A \u0634\u062F\u06CC\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[2]'
      value: "\u06CC\u0639\u0646\u06CC \u0686\u06CC\u061F \u0686\u06CC \u0634\u062F\u0647\u061F"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[3]'
      value: "\u062F\u0633\u062A\u0645 \u062E\u0648\u0631\u062F \u0647\u0645\u0647
        \u0645\u062F\u0627\u0631\u06A9\u062A\u0648 \u0627\u0634\u062A\u0628\u0627\u0647\u06CC
        \u067E\u0627\u06A9 \u06A9\u0631\u062F\u0645 \u062D\u0627\u0644\u0627 \n\u0628\u0627\u06CC\u062F
        \u0647\u0645\u0634\u0648 \u0627\u0632 \u0627\u0648\u0644 \u0628\u06AF\u06CC\u0631\u06CC"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[4]'
      value: "\u0686\u06CC\u06CC\u06CC\u06CC\u061F:/"
