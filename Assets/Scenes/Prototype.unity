      value: "\u0633\u0644\u0627\u0645 \u0645\u062A\u0627\u0633\u0641\u0627\u0646\u0647
        \u0634\u0645\u0627 \u062F\u0631 \u062A\u0635\u062D\u06CC\u062D \u062F\u0631\u0633\u062A
        \u0639\u0645\u0644 \u0646\u06A9\u0631\u062F\u06CC\u062F \u0648 \u0628\u06CC\u0634
        \u0627\u0632 \u062D\u062F \u0628\u0686\u0647 \u0647\u0627 \u0631\u0648 \u067E\u0627\u0633\n
        \u06A9\u0631\u062F\u06CC\u062F\u060C \u0634\u06A9\u0627\u0647\u06CC\u062A
        \u0647\u0627\u06CC\u06CC \u0627\u0632 \u0634\u0645\u0627 \u0634\u062F\u0647
        \u0648 \u0645\u062A\u0627\u0633\u0641\u0627\u0646\u0647 \u0645\u062C\u0628\u0648\u0631\u06CC\u0645
        \u0639\u0630\u0631 \u0634\u0645\u0627 \u0631\u0648 \u0628\u062E\u0648\u0627\u06CC\u0645!\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1555602251553089950, guid: 28497963c24c35245991bbdb6e4577ea, type: 3}
