--- !u!114 &490284709
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 490284706}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e8b123a31fb2dca44b6bc267b7da2f27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePhases:
  - dialogues:
    - "\u0633\u0644\u0627\u0645"
    - "\u0633\u0644\u0627\u0645"
    - "\u0627\u0648\u0645\u062F\u0645 \u0628\u0631\u0627\u06CC \u062B\u0628\u062A
      \u0646\u0627\u0645 "
    - "\u0647\u0647 \u0645\u062F\u0631\u06A9\u062A \u06A9\u0627\u0645\u0644 \u0646\u06CC\u0633\u062A
      \u0628\u062F\u0628\u062E\u062A"
    - "\u062E\u0628 \u0686\u06CC\u06A9\u0627\u0631 \u06A9\u0646\u0645"
    - "\u0628\u0627\u06CC\u062F \u0628\u0631\u06CC \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F
      \u0634\u06A9\u0641\u062A\u0647 \u062A\u0627\n\u0627\u0648\u0644\u06CC\u0646
      \u06A9\u0633\u0631\u06CC \u0645\u062F\u0631\u06A9 \u0627\u062A \u0631\u0648
      \u0628\u06AF\u06CC\u0631\u06CC"
  - dialogues:
    - "\u0633\u0644\u0627\u0645 \u0645\u062C\u062F\u062F "
    - "\u0647\u0645\u0645\u0645\u0645\u0645"
    - "\u0645\u062F\u0631\u06A9 \u0627\u0645 \u0631\u0648 \u0622\u0648\u0631\u062F\u0645
      \u0647\u0645\u0648\u0646\u06CC \u06A9\u0647 \u067E\u06CC\u0634\n\u0627\u0633\u062A\u0627\u062F
      \u0634\u06A9\u0641\u062A\u0647 \u0628\u0648\u062F"
    - "\u0641\u06A9\u0631 \u06A9\u0631\u062F\u06CC \u06A9\u0627\u0631\u062A \u062A\u0645\u0648\u0645
      \u0634\u062F\u0647 \u0628\u062F\u0628\u062E\u062A\u061F\n\u06A9\u0648\u0631
      \u062E\u0648\u0646\u062F\u06CC"
    - "\u062E\u0628 \u0627\u0644\u0627\u0646 \u0628\u0627\u06CC\u062F \u0686\u06CC\u06A9\u0627\u0631
      \u06A9\u0646\u0645\u061F"
    - "\u0628\u0627\u06CC\u062F \u0628\u0631\u06CC \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F
      \u0635\u0641\u0627\u06CC\u06CC \u0648 \n\u06A9\u0633\u0631\u06CC \u0645\u062F\u0631\u06A9
      \u062F\u0648\u0645\u062A \u0631\u0648 \u0628\u06AF\u06CC\u0631\u06CC"
  - dialogues:
    - "\u062E\u0628 \u06A9\u0633\u0631\u06CC \u0645\u062F\u0631\u06A9 \u062F\u0648\u0645\u0645
      \u0631\u0648 \u0647\u0645 \u0622\u0648\u0631\u062F\u0645"
    - "\u0633\u0644\u0627\u0645\u062A \u06A9\u062C\u0627 \u0631\u0641\u062A\u0647
      \u0628\u062F\u0628\u062E\u062A"
    - "\u0628\u0628\u062E\u0634\u06CC\u062F \u0633\u0644\u0627\u0645 \u062D\u0627\u0644\u0627
      \u0645\u06CC\u0634\u0647 \u06A9\u0627\u0631\u0645\n \u0631\u0648 \u0631\u0627\u0647
      \u0628\u0646\u062F\u0627\u0632\u06CC\u0646"
    - "\u062E\u0628 \u062E\u0628 \u062E\u0628 \u0647\u0646\u0648\u0632 \u06A9\u0627\u0631\u0645
      \u0628\u0627\u0647\u0627\u062A \u062A\u0645\u0648\u0645\n \u0646\u0634\u062F\u0647
      \u0628\u0627\u06CC\u062F \u0647\u0646\u0648\u0632\u0645 \u0628\u062F\u0648\u06CC\u06CC"
    - "\u062F\u06CC\u06AF\u0647 \u0628\u0627\u06CC\u062F \u0686\u06A9\u0627\u0631
      \u06A9\u0646\u0645\u061F"
    - "\u0628\u0627\u06CC\u062F \u0628\u0631\u06CC \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F
      \u0645\u0638\u0627\u0647\u0631\u06CC\n\u0648 \u06A9\u0633\u0631\u06CC \u0645\u062F\u0631\u06A9
      \u0627\u062A \u0631\u0648 \u0628\u06CC\u0627\u0631\u06CC"
  - dialogues:
    - "\u062E\u0628 \u0627\u06CC\u0646 \u0645\u062F\u0631\u06A9 \u0631\u0648 \u0647\u0645
      \u0622\u0648\u0631\u062F\u0645 \u062F\u0647\u0646 \u0633\u0631\u0648\u06CC\u0633"
    - "\u0628\u062F\u0628\u062E\u062A \u0686\u0631\u0627 \u0641\u0647\u0634 \u0645\u06CC\u062F\u06CC"
    - "\u062E\u0628 \u0633\u0631\u06CC\u0639 \u062A\u0631 \u0632\u0631\u0627\u062A\u0648
      \u0628\u0632\u0646 \u0645\u06CC\u062E\u0648\u0627\u0645 \n\u062B\u0628\u062A
      \u0646\u0627\u0645 \u06A9\u0646\u0645"
    - "\u0647\u0646\u0648\u0632 \u06A9\u0627\u0631\u0645 \u0628\u0627\u0647\u0627\u062A
      \u062A\u0645\u0648\u0645 \u0646\u0634\u062F\u0647 \u0628\u0627\u06CC\u062F
      \u06CC\u0647 \u06A9\u0627\u0631 \u062F\u06CC\u06AF\u0647 \u0647\u0645 \u0627\u0646\u062C\u0627\u0645
      \u0628\u062F\u06CC"
    - "\u062F\u06CC\u06AF\u0647 \u0628\u0627\u06CC\u062F \u0686\u06CC\u06A9\u0627\u0631
      \u06A9\u0646\u0645\u061F"
    - "\u0628\u0631\u0627\u06CC \u0622\u062E\u0631\u06CC\u0646 \u06A9\u0633\u0631\u06CC
      \u0645\u062F\u0631\u06A9 \u0627\u062A \n\u0628\u0627\u06CC\u062F \u0628\u0631\u06CC
      \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F \u0627\u0633\u0642\u0627\u06CC\u06CC\n"
  listOfTexts:
  - {fileID: 1080279143}
  - {fileID: 547274395}
  - {fileID: 831142251}
  - {fileID: 1569029774}
  - {fileID: 683595365}
