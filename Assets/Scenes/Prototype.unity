    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[5]'
      value: "\u0646\u0645\u06CC \u062F\u0648\u0646\u0645 \u0648\u0627\u0644\u0627
        \u0647\u0631\u0686\u06CC \u0633\u0631\u0686 \u0645\u06CC \u06A9\u0646\u0645
        \u0645\u06CC \u0632\u0646\u0647\n 404NotFound."
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[6]'
      value: "\u062E\u0628 \u06CC\u0647 \u06A9\u0627\u0631\u06CC \u06A9\u0646\u0646\u0646\u0646\u0646\u0646\u0646"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[7]'
      value: "\u0647\u0645\u06CC\u0646\u0647 \u06A9\u0647 \u0647\u0633\u062A. \u0648\u0642\u062A
        \u0646\u0627\u0647\u0627\u0631 \u0648 \u0646\u0645\u0627\u0632 \u0627\u0648\u0645\u062F\u06CC
        \u062F\u0648 \u0642\u0648\u0631\u062A \n\u0648 \u0646\u06CC\u0645\u062A \u0647\u0645
        \u0628\u0627\u0642\u06CC\u0647\u061F "
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[8]'
      value: "\u06CC\u0639\u0646\u06CC \u0631\u0627\u0647 \u062F\u06CC\u06AF\u0647
        \u0627\u06CC \u0646\u06CC\u0633\u062A\u061F \u062F\u0648\u0628\u0627\u0631\u0647
        \u0628\u0631\u0645 \u067E\u06CC\u0634 \u0647\u0645\u0647 \n\u0627\u0633\u0627\u062A\u06CC\u062F\u061F"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[7].dialogues.Array.data[9]'
      value: "\u0686\u0631\u0627 \u06CC\u0647 \u0631\u0627\u0647 \u062F\u06CC\u06AF\u0647
        \u0647\u0633\u062A\u2026 \u0628\u0628\u06CC\u0646 \u062F\u0627\u062E\u0644
        \u06A9\u062A\u0627\u0628\u062E\n\u0648\u0646\u0647 \u0628\u0627\u06CC\u06AF\u0627\u0646\u06CC
        \u0645\u062F\u0627\u0631\u06A9 \u0647\u0633\u062A\u060C \u0628\u0631\u0648
        \u0637\u0628\u0642\u0647 \u0633\u0648\u0645 \u06A9\u067E\u06CC \n\u0645\u062F\u0627\u0631\u06A9\u062A\u0648
        \u0628\u06AF\u06CC\u0631\u060C \u0628\u06CC\u0627\u0631."
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[8].dialogues.Array.data[0]'
      value: "\u062E\u0628 \u0627\u06CC\u0646\u0645 \u0627\u0632 \u06A9\u067E\u06CC
        \u0645\u062F\u0627\u0631\u06A9\u0645\u060C \u062F\u06CC\u06AF\u0647 \u0686\u06CC\u061F
        \u0628\u0627\u0632 \u0628\u0627\u06CC\u062F \n\u0686\u06CC\u06A9\u0627\u0631
        \u06A9\u0646\u0645\u061F \u062D\u0627\u0644\u0627 \u0647\u0645 \u062D\u062A\u0645\u0627
        \u0633\u0627\u0645\u0627\u0646\u0647 \u0642\u0637\u0639\u0647 \u0622\u0631\u0647\u061F\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[8].dialogues.Array.data[1]'
      value: "\u0633\u0627\u0645\u0627\u0646\u0647 \u06A9\u0647 \u06CC\u0647 \u06F3
        \u0633\u0627\u0644\u06CC \u0647\u0633\u062A \u0642\u0637\u0639\u0647 \u06AF\u0644\n\u0645\u062F\u0627\u0631\u06A9\u062A\u0648
        \u0628\u062F\u0647 \u0628\u0628\u06CC\u0646\u0645"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[8].dialogues.Array.data[2]'
      value: "\u0628\u0641\u0631\u0645\u0627\u06CC\u06CC\u062F"
      objectReference: {fileID: 0}
    - target: {fileID: 6802785845645344506, guid: df01bd7453babc543a93d8e46c0145c8, type: 3}
      propertyPath: 'dialoguePhases.Array.data[8].dialogues.Array.data[3]'
      value: "\u062E\u0628\u2026 \u0627\u06CC\u0646\u0645 \u0627\u0632 \u0627\u06CC\u0646
        \u0639\u0632\u06CC\u0632\u0645 \u0647\u0645\u0647 \u0686\u06CC\u0632 \u062F\u0631\u0633\u062A
        \u0628\u0647 \u0646\u0638\u0631 \n\u0645\u06CC\u0631\u0633\u0647 \u0641\u0642\u0637
        \u06CC\u0647 \u0686\u06CC\u0632\u06CC\u2026"
      objectReference: {fileID: 0}
