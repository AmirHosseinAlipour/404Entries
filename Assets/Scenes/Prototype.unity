    - target: {fileID: 8358738472545829038, guid: 28497963c24c35245991bbdb6e4577ea, type: 3}
      propertyPath: m_Text
      value: "\u0627\u0633\u0645: \u0633\u06CC\u0645\u06CC\u0646 \u0641\u0631\u0646\u0648\u0634
        \n\u0634\u0645\u0627\u0631\u0647 \u062F\u0627\u0646\u0634\u062C\u0648\u06CC\u06CC:
        \u06F9\u06F7\u06F4\u06F0\u06F4\u06F2\u06F3\u06F8 \n\u0646\u0645\u0631\u0647
        \u062A\u0635\u062D\u06CC\u062D \u06F1\u06F9.\u06F7\u06F5 \n\n\r\n\u0633\u0644\u0627\u0645
        \u0627\u0633\u062A\u0627\u062F \u062E\u0633\u062A\u0647 \u0646\u0628\u0627\u0634\u06CC\u0646
        \u062E\u06CC\u0644\u06CC \u0645\u0645\u0646\u0648\u0646 \u0627\u0632 \u062A\u062F\u0631\u06CC\u0633
        \u062E\u0648\u0628\u06CC \u06A9\u0647 \u062F\u0627\u0634\u062A\u06CC\u062F.
        \u0634\u0645\u0627 \u06CC\u06A9\u06CC \u0627\u0632 \u0628\u0647\u062A\u0631\u06CC\u0646
        \u0627\u0633\u0627\u062A\u06CC\u062F\u06CC \u0628\u0648\u062F\u06CC\u062F
        \u06A9\u0647 \u062F\u0631 \u0627\u06CC\u0646 \u062A\u0631\u0645 \u0648 \u062D\u062A\u06CC
        \u062F\u0631 \u062F\u0648\u0631\u0647 \u06A9\u0627\u0631\u0634\u0646\u0627\u0633\u06CC
        \u0628\u0627\u0647\u0627\u0634\u0648\u0646 \u06A9\u0644\u0627\u0633 \u062F\u0627\u0634\u062A\u0645\u060C
        \u0627\u0645\u06CC\u062F\u0648\u0627\u0631\u0645 \u0647\u0631\u062C\u0627
        \u06A9\u0647 \u0647\u0633\u062A\u06CC\u062F \u0633\u0627\u0644\u0645 \u0648
        \u0633\u0644\u0627\u0645\u062A \u0628\u0627\u0634\u06CC\u062F\r"
      objectReference: {fileID: 0}
