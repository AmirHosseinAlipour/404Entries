--- !u!114 &2173287433119703445
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1890386176459174445}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e8b123a31fb2dca44b6bc267b7da2f27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePhases:
  - dialogues:
    - "\u0633\u0644\u0627\u0645"
    - "\u0633\u0644\u0627\u0645 \u062F\u062E\u062A\u0631\u06A9 \u0632\u0634\u062A"
    - "\u0627\u0648\u0645\u062F\u0645 \u0628\u0631\u0627\u06CC \u062B\u0628\u062A
      \u0646\u0627\u0645 "
    - "\u0631\u06CC\u062F\u06CC \u0628\u0627\u06CC\u062F \u0645\u062F\u0627\u0631\u06A9\u062A
      \u06A9\u0627\u0645\u0644 \u0628\u0627\u0634\u0647"
    - "\u062E\u0628 \u0686\u06CC\u06A9\u0627\u0631 \u06A9\u0646\u0645"
    - "\u0628\u0627\u06CC\u062F \u0628\u0631\u06CC \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F
      \u0634\u06A9\u0641\u062A\u0647"
  - dialogues:
    - "\u0633\u0644\u0627\u0645 \u0645\u062C\u062F\u062F "
    - "\u0647\u0645\u0645\u0645\u0645\u0645"
    - "\u0645\u062F\u0631\u06A9 \u0627\u0645 \u0631\u0648 \u0622\u0648\u0631\u062F\u0645
      \u0647\u0645\u0648\u0646\u06CC \u06A9\u0647 \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F
      \u0634\u06A9\u0641\u062A\u0647 \u0628\u0648\u062F"
    - "\u0641\u06A9\u0631 \u06A9\u0631\u062F\u06CC \u06A9\u0627\u0631\u062A \u062A\u0645\u0648\u0645
      \u0634\u062F\u0647 \u062F\u062E\u062A\u0631\u06A9 \u0632\u0634\u062A\u061F
      \u06A9\u0648\u0631 \u062E\u0648\u0646\u062F\u06CC"
    - "\u062E\u0628 \u0627\u0644\u0627\u0646 \u0628\u0627\u06CC\u062F \u0686\u06CC\u06A9\u0627\u0631
      \u06A9\u0646\u0645\u061F"
    - "\u0628\u0627\u06CC\u062F \u0628\u0631\u06CC \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F
      \u0635\u0641\u0627\u06CC\u06CC \u0648 \u06A9\u0633\u0631\u06CC \u0645\u062F\u0631\u06A9
      \u062F\u0648\u0645\u062A \u0631\u0648 \u0628\u06AF\u06CC\u0631\u06CC"
  - dialogues:
    - "\u062E\u0628 \u0645\u062F\u0631\u06A9 \u0635\u0641\u0627\u06CC\u06CC \u06A9\u0647
      \u06AF\u0641\u062A\u0647 \u0628\u0648\u062F\u06CC \u0631\u0648 \u062C\u0648\u0631
      \u06A9\u0631\u062F\u0645"
    - "\u062F\u062E\u062A\u0631\u06A9 \u0632\u0634\u062A \u0633\u0644\u0627\u0645\u062A
      \u06A9\u062C\u0627 \u0631\u0641\u062A\u0647"
    - "\u0628\u0628\u062E\u0634\u06CC \u0633\u0644\u0627\u0645 \u062D\u0627\u0644\u0627
      \u0645\u06CC\u0634\u0647 \u06A9\u0627\u0631\u0645 \u0631\u0648 \u0631\u0627\u0647
      \u0628\u0646\u062F\u0627\u0632\u06CC\u0646"
    - "\u062E\u0628 \u062E\u0628 \u062E\u0628 \u0647\u0646\u0648\u0632 \u06A9\u0627\u0631\u0645
      \u0628\u0627\u0647\u0627\u062A \u062A\u0645\u0648\u0645 \u0646\u0634\u062F\u0647
      \u0628\u0627\u06CC\u062F \u0647\u0646\u0648\u0632\u0645 \u0628\u062F\u0648\u06CC\u06CC"
    - "\u062F\u06CC\u06AF\u0647 \u0628\u0627\u06CC\u062F \u0686\u06A9\u0627\u0631
      \u06A9\u0646\u0645"
    - "\u0628\u0627\u06CC\u062F \u0628\u0631\u06CC \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F
      \u0627\u0633\u0642\u0627\u06CC\u06CC \u0648 \u062F\u0631 \u06A9\u0644\u0627\u0633\u0634
      \u0634\u0631\u06A9\u062A \u06A9\u0646\u06CC"
  - dialogues:
    - "\u062E\u0628 \u062E\u0628 \u062E\u0627\u0631\u06A9\u0635\u0647 \u0645\u062F\u0627\u0631\u06A9
      \u0631\u0648 \u062C\u0648\u0631 \u06A9\u0631\u062F\u0645"
    - "\u06A9\u0633\u0634\u06A9 \u0686\u0631\u0627 \u0641\u0647\u0634 \u0645\u06CC\u062F\u06CC"
    - "\u062E\u0628 \u0633\u0631\u06CC\u0639 \u062A\u0631 \u0632\u0631\u0627\u062A\u0648
      \u0628\u0632\u0646 \u0645\u06CC\u062E\u0648\u0627\u0645 \u062B\u0628\u062A
      \u0646\u0627\u0645 \u06A9\u0646\u0645"
    - "\u0647\u0646\u0648\u0632 \u06A9\u0627\u0631\u0645 \u0628\u0627\u0647\u0627\u062A
      \u062A\u0645\u0648\u0645 \u0646\u0634\u062F\u0647 \u0628\u0627\u06CC\u062F
      \u06CC\u0647 \u06A9\u0627\u0631 \u062F\u06CC\u06AF\u0647 \u0628\u06A9\u0646\u06CC"
    - "\u062F\u06CC\u06AF\u0647 \u0628\u0627\u06CC\u062F \u0686\u06CC\u06A9\u0627\u0631
      \u06A9\u0646\u0645 \u0634\u0648\u0647\u0631 \u062C\u0646\u062F\u0647"
    - "\u0628\u0631\u0627\u06CC \u06A9\u0633\u0631\u06CC \u0645\u062F\u0631\u06A9
      \u0622\u062E\u0631\u062A \u0628\u0627\u06CC\u062F \u0628\u0631\u06CC \u067E\u06CC\u0634
      \u0627\u0633\u062A\u0627\u062F \u0645\u0638\u0627\u0647\u0631\u06CC \u0648
      \u0645\u062F\u0631\u06A9 \u0627\u062A \u0631\u0648 \u0627\u0632\u0634 \u0628\u06AF\u06CC\u0631\u06CC
      \u06A9\u0633\u06A9\u0634"
  listOfTexts:
  - {fileID: 4546331128554864488}
  - {fileID: 1243325389626438271}
  - {fileID: 8959858364249742897}
  - {fileID: 5288591947490212357}
  - {fileID: 8082782763260103992}
  - {fileID: 8179225520228389596}
