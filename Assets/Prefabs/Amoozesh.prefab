  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePhases:
  - dialogues:
    - "\u0633\u0644\u0627\u0645 \u0627\u0648\u0645\u062F\u0645 \u0628\u0631\u0627\u06CC
      \u062A\u062D\u0648\u06CC\u0644 \u0645\u062F\u0631\u06A9"
    - "\u0648\u0642\u062A \u0646\u0627\u0647\u0627\u0631 \u0646\u0645\u0627\u0632\u0647
      \u0628\u0631\u06CC\u062F \u0628\u0639\u062F\u0627 \u0628\u06CC\u0627\u06CC\u062F"
    - "\u0627\u0644\u0627\u0646 \u06A9\u0647 \u06F8 \u0635\u0628\u062D\u0647 :| \u0627\u06CC\u0646
      \u0645\u062F\u0627\u0631\u06A9 \u0645\u0646 \u062E\u062F\u0645\u062A \u0634\u0645\u0627
      \u06CC\u0647 \u0646\u06AF\u0627\u0647 \u0628\u0646\u062F\u0627\u0632\u06CC\u062F\r\n"
    - "\u062E\u0627\u06A9 \u0628\u0631 \u0633\u0631\u062A \u0627\u06CC\u0646 \u0647\u0645\u0634
      \u0645\u0634\u06A9\u0644 \u062F\u0627\u0631\u0647 \u062A\u0648 \u0686\u0637\u0648\u0631\u06CC
      \u0628\u0647\u0634\u062A\u06CC \u0642\u0628\u0648\u0644 \u0634\u062F\u06CC\u061F\r\n"
    - "\u0686\u0647 \u0637\u0631\u0632 \u062D\u0631\u0641 \u0632\u062F\u0646\u0647.
      \u062D\u0627\u0644\u0627 \u0628\u0627\u06CC\u062F \u0686\u06CC\u06A9\u0627\u0631
      \u06A9\u0646\u0645\u061F\r\n"
    - "\u0628\u0628\u06CC\u0646\u2026 \u0628\u0633\u062A\u06AF\u06CC \u0628\u0647
      \u062E\u0648\u062F\u062A \u062F\u0627\u0631\u0647 \u0645\u06CC\u062A\u0648\u0646\u0647
      \u06F5 \u062F\u0642\u06CC\u0642\u0647 \u0637\u0648\u0644 \u0628\u06A9\u0634\u0647
      \u06CC\u0627 \u06F5 \u0633\u0627\u0639\u062A.\r\n"
    - " \u06CC\u0639\u0646\u06CC \u0686\u06CC\u061F"
    - "\u0647\u0631 \u06A9\u062F\u0648\u0645 \u0627\u0632 \u0645\u062F\u0627\u0631\u06A9
      \u062F\u0633\u062A \u06CC\u06A9\u06CC \u0627\u0632 \u0627\u0633\u0627\u062A\u06CC\u062F\u0647\u060C
      \u0628\u0631\u0648 \u067E\u06CC\u0634 \n\u0647\u0631 \u06A9\u062F\u0648\u0645
      \u0627\u0632 \u0627\u0633\u0627\u062A\u06CC\u062F\u060C \u0645\u062F\u0627\u0631\u06A9\u062A
      \u0631\u0648 \u0628\u06AF\u06CC\u0631 \u0648 \u0628\u06CC\u0627\u0631\u0634\u0648\u0646
      \n\u067E\u06CC\u0634 \u0645\u0646\u060C \u0645\u0641\u0647\u0648\u0645\u0647\u061F\r\n"
    - " \u0627\u0648\u06A9\u06CC \u062D\u0627\u0644\u0627 \u0628\u0627\u06CC\u062F
      \u0686\u06CC\u06A9\u0627\u0631 \u06A9\u0646\u0645\u061F\r\n"
    - "\u062E\u0628 \u0627\u0644\u0627\u0646 \u0628\u0627\u06CC\u062F \u0628\u0631\u06CC
      \u067E\u06CC\u0634 \u0627\u0633\u062A\u0627\u062F \u0645\u0638\u0627\u0647\u0631\u06CC\u060C
      \u0627\u06CC\u0634\u0648\u0646 \u062F\u0631 \u06A9\u0644\u0627\u0633 \u06F0\u06F0\u06F9
      \u062F\u0627\u0631\u0646 \u06A9\u0627\u0631\u0628\u06CC\u0646\u06CC \u062A\u062F\u0631\u06CC\u0633
      \u0645\u06CC \u06A9\u0646\u0646\r\n"
  - dialogues:
    - "\u062E\u0628 \u0627\u06CC\u0646\u0645 \u0627\u0632 \u0645\u062F\u0631\u06A9
      \u062D\u0627\u0644\u0627 \u0645\u06CC\u0634\u0647 \u062B\u0628\u062A \u0646\u0627\u0645\u0645
      \u06A9\u0646\u06CC\u061F\r\n"
    - "\u0647\u0647 \u0641\u0634\u0627\u0631 \u0628\u062E\u0648\u0631\u060C \u0627\u06CC\u0646
      \u0627\u0648\u0644\u06CC\u0634 \u0628\u0648\u062F \u0647\u0646\u0648\u0632
      \u06A9\u0644\u06CC\u06CC\u06CC \u06A9\u0633\u0631\u06CC \u0645\u062F\u0631\u06A9
      \u062F\u0627\u0631\u06CC\u060C \u0627\u0632 \u06F8 \n\u0645\u062F\u0631\u06A9\u06CC
      \u06A9\u0647 \u0628\u0627\u06CC\u062F \u062A\u062D\u0648\u06CC\u0644 \u0628\u062F\u06CC
      \u06F6 \u062A\u0627\u0634 \u0646\u0627\u0642\u0635\u0647.\r\n"
    - "\u0686\u06CC\u06CC\u06CC\u06CC\u061F \u06CC\u0627\u0639\u0644\u06CC\u06CC\u06CC\u06CC.\r\n"
    - "\u0647\u0645\u06CC\u0646\u0633 \u06A9\u0647 \u0647\u0633\u062A."
    - "\u0639\u0647 \u0686\u0631\u0627 \u06CC\u0647 \u062F\u0641\u0639\u0639\u0647
      \u0644\u0647\u062C\u0647 \u0627\u0635\u0641\u0647\u0627\u0646\u06CC \u06AF\u0631\u0641\u062A\u06CC\u0646\u061F
      \u0627\u0635\u0627\u0644\u062A\u0627\n \u0627\u0635\u0641\u0647\u0627\u0646\u06CC
      \u0647\u0633\u062A\u06CC\u0646\u061F\r\n"
    - "\u0646\u0647  \u062A\u0642\u0635\u06CC\u0631 \u0627\u06CC\u0646 \u062F\u06CC\u0627\u0644\u0648\u06AF
      \u0646\u0648\u06CC\u0633\u0645\u0647 \u062E\u0648\u062F\u0634 \u0627\u0635\u0641\u0647\u0627\u0646\u06CC\u0647
      \u0648\u06AF\u0631\u0646\u0647 \u062E\u0648\u062F\u0645 \u062A\u0648\u0631\u06A9\u0645.\r\n"
    - " \u0648\u0627\u0642\u0639\u0627 \u0646\u0645\u06CC\u0641\u0647\u0645\u0645
      \u0686\u06CC \u0645\u06CC\u06AF\u06CC"
    - "\u0647\u06CC\u0686\u06CC \u0648\u0644\u0634 \u06A9\u0646 \r\n"
    - "\u062E\u0628 \u0645\u06CC\u0634\u0647 \u0628\u06AF\u06CC \u0627\u0633\u062A\u0627\u062F
      \u0628\u0639\u062F\u06CC \u06A9\u06CC\u0647\u061F\r\n"
    - "\u0627\u0633\u062A\u0627\u062F \u0628\u0639\u062F\u06CC \u062F\u06A9\u062A\u0631
      \u0645\u0644\u06A9\u060C \u062F\u0627\u0631\u0646 \u062F\u0631 \u06A9\u0644\u0627\u0633
      \u06F1\u06F1\u06F1 \u06A9\u0627\u0631\u0628\u06CC\u0646\u06CC \u062A\u062F\u0631\u06CC\u0633
      \u0645\u06CC \u06A9\u0646\u0646\u062F.\r\n"
  - dialogues:
    - " \u062E\u0628 \u0627\u06CC\u0646\u0645 \u0627\u0632 \u0645\u062F\u0631\u06A9
      \u062F\u0648\u0645\u060C \u0628\u0647 \u0632\u0648\u0631 \u0628\u06CC\u062F\u0627\u0631\u0645
      \u0648\u0627\u0642\u0639\u0627.."
    - "\u0686\u06CC\u061F \u0647\u0627\u0646\u061F \u0622\u0647\u0627 \u0628\u0631\u06AF\u0634\u062A\u06CC\u061F"
    - "\u062E\u0648\u0627\u0628 \u0628\u0648\u062F\u06CC\u0646\u061F :|"
    - "\u0646\u0647 \u0628\u0627\u0628\u0627 \u062F\u0627\u0634\u062A\u0645\u2026
      \u06AF\u0644\u0648\u0645\u0648 \u0635\u0627\u0641 \u0645\u06CC \u06A9\u0631\u062F\u0645"
    - " \u0622\u0647\u0627\u0646\u060C\u0635\u062D\u06CC\u062D."
    - "\u0628\u0627\u0634\u0647 \u062D\u0627\u0644\u0627 \u067E\u0631\u0648 \u0646\u0634\u0648
      \u062F\u06CC\u06AF\u0647."
    - "\u0686\u0634\u0645\u060C \u062D\u0627\u0644\u0627 \u06A9\u062C\u0627 \u0628\u0627\u06CC\u062F
      \u0628\u0631\u0645\u061F"
    - "\u0628\u0631\u0627\u06CC \u0645\u062F\u0631\u06A9 \u0633\u0648\u0645 \u0628\u0627\u06CC\u062F
      \u0628\u0631\u06CC\u062F \u067E\u06CC\u0634 \u062F\u06A9\u062A\u0631 \u0634\u06A9\u0641\u062A\u0647\u060C
      \n\u0627\u06CC\u0634\u0648\u0646 \u0627\u06A9\u062B\u0631\u0627 \u062F\u0627\u062E\u0644
      \u062F\u0641\u062A\u0631\u0634\u0648\u0646 \u062F\u0631 \u0637\u0628\u0642\u0647
      \u062F\u0648 \u0647\u0633\u062A\u0646."
  - dialogues:
    - "\u0648\u0627\u06CC\u2026 \u0686\u0642\u062F\u0631\u2026 \u0637\u0648\u0644
      \u06A9\u0634\u06CC\u062F \u0627\u06CC\u0646\u0645 \u0627\u0632 \u0645\u062F\u0631\u06A9
      \u0633\u0648\u0645.\r\n"
    - "\u0627\u0644\u0627\u0646 \u062F\u06CC\u06AF\u0647 \u0648\u0627\u0642\u0639\u0627
      \u0648\u0642\u062A \u0646\u0645\u0627\u0632 \u0648 \u0646\u0627\u0647\u0627\u0631\u0647.
      \u0628\u0631\u0648 \u06CC\u0647 \u0646\u06CC\u0645 \n\u0633\u0627\u0639\u062A
      \u062F\u06CC\u06AF\u0647 \u0628\u06CC\u0627\r\n"
    - "\u0686\u06CC\u061F \u062E\u0628 \u0627\u06CC\u0646\u0637\u0648\u0631\u06CC
      \u06A9\u0647 \u0645\u0646 \u062A\u0627 \u0622\u062E\u0631 \u0634\u0628 \u0647\u0645
      \u0646\u0645\u06CC \u062A\u0648\u0646\u0645 \n\u062B\u0628\u062A \u0646\u0627\u0645
      \u0631\u0648 \u062A\u0645\u0648\u0645 \u06A9\u0646\u0645.\r\n"
    - "\u062E\u0628\u2026 \u0628\u0647 \u0645\u0646 \u0686\u0647\u061F"
    - "\u062E\u0628 \u06CC\u0639\u0646\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u0622\u062F\u0645
      \u0628\u06CC\u0634\u0648.."
    - "\u0686\u06CC\u061F \u0686\u06CC \u06AF\u0641\u062A\u06CC \u0639\u0632\u06CC\u0632\u0645\u061F"
    - " \u0647\u06CC\u0686\u06CC \u06AF\u0641\u062A\u0645 \u0627\u06AF\u0647 \u0645\u06CC\u0634\u0647\u2026
      \u0627\u0645\u06A9\u0627\u0646\u0634 \u0647\u0633\u062A\u2026 \u0644\u0637\u0641\u0627\u2026
      \u06A9\u0627\u0631 \u0647\u0627\u06CC \u0645\u0646\u0648 \u067E\u06CC\u0634
      \u0628\u0628\u0631\u06CC\u062F."
    - "\u062D\u0627\u0644\u0627 \u06A9\u0647 \u062E\u0648\u0627\u0647\u0634 \u0645\u06CC
      \u06A9\u0646\u06CC \u06CC\u0647 \u06A9\u0627\u0631\u06CC \u0645\u06CC \u06A9\u0646\u0645
      \u0628\u0631\u0627\u062A\u060C \n\u0628\u0639\u062F\u06CC \u062F\u06A9\u062A\u0631
      \u0639\u0644\u06CC \u0627\u06A9\u0628\u0631\u06CC\u0647 "
    - " \u0627\u0633\u0645 \u0648 \u0641\u0627\u0645\u06CC\u0644\u0634\u0648\u0646
      \u0639\u0644\u06CC \u0627\u06A9\u0628\u0631\u06CC\u0647\u061F"
    - "\u0646\u0647\u060C \u0635\u0627\u062F\u0642 \u0639\u0644\u06CC \u0627\u06A9\u0628\u0631\u06CC
      \u06A9\u0644\u0627\u0633\u0634\u0648\u0646 \u0647\u0645 \u062F\u0631 \u06F1\u06F0\u06F1
      \u062F\u0627\u0631\u0647 \u0628\u0631\u06AF\u0632\u0627\u0631 \u0645\u06CC\u0634\u0647."
  - dialogues:
    - " \u062E\u0628 \u0627\u06CC\u0646\u0645 \u0627\u0632 \u0627\u0633\u062A\u0627\u062F
      \u0639\u0644\u06CC \u0627\u06A9\u0628\u0631\u06CC \u0648 \u0645\u062F\u0631\u06A9
      \u0686\u0647\u0627\u0631\u0645."
    - "\u062E\u0628 \u062E\u0628 \u0686\u0637\u0648\u0631 \u0628\u0648\u062F\u061F\r\n"
    - "\u0647\u0646\u0648\u0632 \u0646\u06CC\u0648\u0645\u062F\u0647 \u0627\u0632\u0645
      \u06A9\u0648\u0626\u06CC\u0632 \u06AF\u0631\u0641\u062A\u0646:("
    - "\u062F\u0631\u0633\u062A\u0634 \u0647\u0645 \u0647\u0645\u06CC\u0646\u0647\u060C
      \u062D\u0627\u0644\u0627 \u06A9\u062C\u0627\u0634\u0648 \u062F\u06CC\u062F\u06CC\u060C  
      \u062F\u062F\u0644\u0627\u06CC\u0646 \n\u0647\u0627 \u062F\u0631 \u0627\u0646\u062A\u0638\u0627\u0631\u062A\u0647."
    - "\u0647\u0639\u06CC.. \u062E\u0628 \u062D\u0627\u0644\u0627 \u0627\u0633\u062A\u0627\u062F
      \u0628\u0639\u062F\u06CC \u06A9\u06CC\u0647\u061F"
    - "\u0627\u0633\u062A\u0627\u062F \u0628\u0639\u062F\u06CC\u2026 \u062F\u06A9\u062A\u0631
      \u0635\u0641\u0627\u06CC\u06CC \u06A9\u0647 \u062F\u0631 \u06A9\u0644\u0627\u0633
      116 \u0647\u0633\u062A\u0646\u062F.\r\n"
  - dialogues:
    - "\u0627\u06CC\u0646\u0645 \u0627\u0632 paper \u067E\u0646\u062C\u0645 \u06A9\u0647
      \u062F\u06A9\u062A\u0631 \u0635\u0641\u0627\u06CC\u06CC \u0627\u0645\u0636\u0627
      \u06A9\u0631\u062F\u0646"
    - "\u062E\u0633\u062A\u0647 \u0646\u0628\u0627\u0634\u06CC\u060C \u0641\u0642\u0637
      \u06F2 \u062A\u0627 \u0645\u062F\u0631\u06A9 \u062F\u06CC\u06AF\u0647 \u0645\u0648\u0646\u062F\u0647!"
    - "\u0645\u0631\u0633\u06CC \u06A9\u0647 \u062D\u062F\u0627\u0642\u0644 \u0631\u0648\u062D\u06CC\u0647
      \u0645\u06CC\u062F\u06CC\u060C \u0627\u0633\u062A\u0627\u062F \u0628\u0639\u062F\u06CC
      \u06A9\u06CC\u0647\u061F"
    - "\u0627\u0633\u062A\u0627\u062F \u0645\u0639\u0635\u0648\u0645\u06CC \u062F\u0627\u0631\u0646
      \u062F\u0631 \u06A9\u0644\u0627\u0633 \u06F1\u06F0\u06F8 \u062A\u062F\u0631\u06CC\u0633
      \u0645\u06CC \u06A9\u0646\u0646 \n\u0632\u0648\u062F \u0628\u0631\u0648 \u062A\u0627
      \u06A9\u0644\u0627\u0633\u0634 \u062A\u0645\u0648\u0645 \u0646\u0634\u062F\u0647."
  - dialogues:
    - "\u0641\u0642\u0637 \u0628\u06AF\u0648 \u0627\u0633\u062A\u0627\u062F \u0628\u0639\u062F\u06CC
      \u06A9\u06CC\u0647\u061F\r\n"
    - "\u0639\u062F\u06CC \u0627\u0633\u062A\u0627\u062F \u0627\u0633\u0642\u0627\u06CC\u06CC\u060C
      \u062F\u0631 \u06A9\u0644\u0627\u0633\u06F1\u06F1\u06F2 \u0645\u0634\u063A\u0648\u0644
      \u062A\u062F\u0631\u06CC\u0633 \n\u0647\u0633\u062A\u0646.\r\n"
    - "\u062D\u0644\u0647 \u067E\u0633 \u0645\u0646 \u0631\u0641\u062A\u0645.\r\n"
    - "\u0641\u0642\u0637 \u06CC\u0647 \u0686\u06CC\u0632\u06CC\u060C \u0627\u06CC\u0634\u0648\u0646
      \u06CC\u06A9\u0645\u06CC \u062D\u0633\u0627\u0633\u0646 \u06A9\u0647 \u0633\u0631
      \u06A9\u0644\u0627\u0633\n \u0645\u0632\u0627\u062D\u0645\u0634\u0648\u0646
      \u0628\u0634\u06CC\u060C \u0628\u0627\u06CC\u062F \u062F\u0632\u062F\u06A9\u06CC
      \u0628\u0631\u06CC \u0645\u062F\u0631\u06A9\u062A\u0648 \u0628\u0631\u062F\u0627\u0631\u06CC."
    - "\u0645\u06AF\u0647 \u0642\u0631\u0627\u0631 \u0646\u0628\u0648\u062F \u0641\u0642\u0637
      \u0642\u0628\u0648\u0644\u06CC \u062A\u0648 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647
      \u0633\u062E\u062A \u0628\u0627\u0634\u0647\u061F \n\u067E\u0633 \u0627\u06CC\u0646
      \u062B\u0628\u062A \u0646\u0627\u0645\u0634 \u0686\u06CC \u0645\u06CC\u06AF\u0647:((("
    - "\u062D\u0627\u0644\u0627 \u0628\u0630\u0627\u0631 \u0628\u0639\u062F\u0634\u0648
      \u0628\u0628\u06CC\u0646\u06CC:)))\r\n"
  - dialogues:
    - " \u062E\u0628 \u062F\u06CC\u06AF\u0647\u2026\u062A\u0645\u0648\u0645 \u0634\u062F
      \u062F\u06CC\u06AF\u0647 \u0622\u0631\u0647\u061F"
    - "\u0628\u0630\u0627\u0631 \u06CC\u0647 \u0646\u06AF\u0627\u0647 \u0628\u0646\u062F\u0627\u0632\u0645\u2026.
      \u0627\u0648\u0647. \u0628\u062F\u0628\u062E\u062A \u0634\u062F\u06CC\u2026"
    - "\u06CC\u0639\u0646\u06CC \u0686\u06CC\u061F \u0686\u06CC \u0634\u062F\u0647\u061F"
    - "\u062F\u0633\u062A\u0645 \u062E\u0648\u0631\u062F \u0647\u0645\u0647 \u0645\u062F\u0627\u0631\u06A9\u062A\u0648
      \u0627\u0634\u062A\u0628\u0627\u0647\u06CC \u067E\u0627\u06A9 \u06A9\u0631\u062F\u0645
      \u062D\u0627\u0644\u0627 \n\u0628\u0627\u06CC\u062F \u0647\u0645\u0634\u0648\n
      \u0627\u0632 \u0627\u0648\u0644 \u0628\u06AF\u06CC\u0631\u06CC"
    - "\u0686\u06CC\u06CC\u06CC\u06CC\u061F:/"
    - "\u0646\u0645\u06CC \u062F\u0648\u0646\u0645 \u0648\u0627\u0644\u0627 \u0647\u0631\u0686\u06CC
      \u0633\u0631\u0686 \u0645\u06CC \u06A9\u0646\u0645 \u0645\u06CC \u0632\u0646\u0647\n
      404NotFound."
    - "\u062E\u0628 \u06CC\u0647 \u06A9\u0627\u0631\u06CC \u06A9\u0646\u0646\u0646\u0646\u0646\u0646\u0646"
    - "\u0647\u0645\u06CC\u0646\u0647 \u06A9\u0647 \u0647\u0633\u062A. \u0648\u0642\u062A
      \u0646\u0627\u0647\u0627\u0631 \u0648 \u0646\u0645\u0627\u0632 \u0627\u0648\u0645\u062F\u06CC
      \u062F\u0648 \u0642\u0648\u0631\u062A \n\u0648 \u0646\u06CC\u0645\u062A \u0647\u0645
      \u0628\u0627\u0642\u06CC\u0647\u061F "
    - "\u06CC\u0639\u0646\u06CC \u0631\u0627\u0647 \u062F\u06CC\u06AF\u0647 \u0627\u06CC
      \u0646\u06CC\u0633\u062A\u061F \u062F\u0648\u0628\u0627\u0631\u0647 \u0628\u0631\u0645
      \u067E\u06CC\u0634 \u0647\u0645\u0647 \n\u0627\u0633\u0627\u062A\u06CC\u062F\u061F"
    - "\u0686\u0631\u0627 \u06CC\u0647 \u0631\u0627\u0647 \u062F\u06CC\u06AF\u0647
      \u0647\u0633\u062A\u2026 \u0628\u0628\u06CC\u0646 \u062F\u0627\u062E\u0644
      \u06A9\u062A\u0627\u0628\u062E\n\u0648\u0646\u0647 \u0628\u0627\u06CC\u06AF\u0627\u0646\u06CC
      \u0645\u062F\u0627\u0631\u06A9 \u0647\u0633\u062A\u060C \u0628\u0631\u0648
      \u0637\u0628\u0642\u0647 \u0633\u0648\u0645 \u06A9\u067E\u06CC \n\u0645\u062F\u0627\u0631\u06A9\u062A\u0648
      \u0628\u06AF\u06CC\u0631\u060C \u0628\u06CC\u0627\u0631."
  - dialogues:
    - "\u062E\u0628 \u0627\u06CC\u0646\u0645 \u0627\u0632 \u06A9\u067E\u06CC \u0645\u062F\u0627\u0631\u06A9\u0645\u060C
      \u062F\u06CC\u06AF\u0647 \u0686\u06CC\u061F \u0628\u0627\u0632 \u0628\u0627\u06CC\u062F
      \n\u0686\u06CC\u06A9\u0627\u0631 \u06A9\u0646\u0645\u061F \n\u062D\u0627\u0644\u0627
      \u0647\u0645 \u062D\u062A\u0645\u0627 \u0633\u0627\u0645\u0627\u0646\u0647
      \u0642\u0637\u0639\u0647 \u0622\u0631\u0647\u061F\r\n"
    - "\u0633\u0627\u0645\u0627\u0646\u0647 \u06A9\u0647 \u06CC\u0647 \u06F3 \u0633\u0627\u0644\u06CC
      \u0647\u0633\u062A \u0642\u0637\u0639\u0647 \u06AF\u0644\n\u0645\u062F\u0627\u0631\u06A9\u062A\u0648
      \u0628\u062F\u0647 \u0628\u0628\u06CC\u0646\u0645"
    - "\u0628\u0641\u0631\u0645\u0627\u06CC\u06CC\u062F"
    - "\u062E\u0628\u2026 \u0627\u06CC\u0646\u0645 \u0627\u0632 \u0627\u06CC\u0646
      \u0639\u0632\u06CC\u0632\u0645 \u0647\u0645\u0647 \u0686\u06CC\u0632 \u062F\u0631\u0633\u062A
      \u0628\u0647 \u0646\u0638\u0631 \n\u0645\u06CC\u0631\u0633\u0647 \n\u0641\u0642\u0637
      \u06CC\u0647 \u0686\u06CC\u0632\u06CC\u2026"
