  m_Text: "\u062E\u0628 \u0628\u06CC\u0627 \u0628\u06CC\u0627 \u0627\u06CC\u0646\u062C\u0627
    \u0628\u0628\u06CC\u0646\u0645 \u067E\u0633\u0631 \u062E\u0648\u0628 \u0627\u06CC\u0646
    \u0645\u062F\u0631\u06A9 \u0645\u062F\u0631\u06A9 \u06A9\u0647\n \u0645\u06CC\u06AF\u06CC
    \u0686\u06CC \u0647\u0633\u062A\u061F \u0627\u0635\u0644\u0627 \u06A9\u06CC \u06AF\u0641\u062A\u0647
    \u0645\u062F\u0631\u06A9\u06CC \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u0647\u061F\r\n"
