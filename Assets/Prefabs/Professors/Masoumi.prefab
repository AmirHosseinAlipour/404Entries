  - {fileID: 1637473761404792630}
  - {fileID: 53235359044199691}
  - {fileID: 1819139458125359300}
  zonesToDrop:
  - {fileID: 8752646718295951279}
  - {fileID: 4165217903301089246}
  - {fileID: 4465009468631302870}
  items:
  - {fileID: 152849231286266976}
  - {fileID: 4887227559670002320}
  - {fileID: 7137835475186805699}
  itemsOptionsTexts:
  - {fileID: 6266266076069043559}
  - {fileID: 8406892766340737558}
  - {fileID: 5877087478464799647}
  texts:
  - "\u062E\u0628 \u0628\u06CC\u0627 \u0628\u06CC\u0627 \u0627\u06CC\u0646\u062C\u0627
    \u0628\u0628\u06CC\u0646\u0645 \u067E\u0633\u0631 \u062E\u0648\u0628 \u0627\u06CC\u0646
    \u0645\u062F\u0631\u06A9 \u0645\u062F\u0631\u06A9 \u06A9\u0647\n \u0645\u06CC\u06AF\u06CC
    \u0686\u06CC \u0647\u0633\u062A\u061F \u0627\u0635\u0644\u0627 \u06A9\u06CC \u06AF\u0641\u062A\u0647
    \u0645\u062F\u0631\u06A9\u06CC \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u0647\u061F\r\n"
  - "\u062E\u0628 \u0628\u0627\u0634\u0647 \u0627\u0635\u0644\u0627 \u0631\u0627\u0633\u062A
    \u0645\u06CC\u06AF\u06CC\u060C  \u06CC\u0647 \u0645\u062F\u0631\u06A9\u06CC \u0648\u062C\u0648\u062F
    \u062F\u0627\u0631\u0647 \u0648\u0644\u06CC \u06A9\u06CC\n \u06AF\u0641\u062A\u0647
    \u0627\u06CC\u0646\u062C\u0627 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647\u0647\u061F
    \u0634\u0627\u06CC\u062F  \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0648\u0645\u062F\u06CC
    \u0627\u0635\u0644\u0627 \u0627\u06CC\u0646\u062C\u0627\n \u062F\u0627\u0646\u0634\u06AF\u0627\u0647
    \u0646\u06CC\u0633\u062A\r\n"
  - "\u0648\u0627\u06CC\u0633\u0627 \u0628\u0628\u06CC\u0646\u0645 \u0627\u0635\u0644\u0627
    \u06CC\u0647 \u0633\u0648\u0627\u0644 \u06AF\u0646\u062F\u0647 \u062A\u0631 \u06A9\u06CC
    \u06AF\u0641\u062A\u0647 \u0645\u0646\n \u0627\u0633\u062A\u0627\u062F \u0627\u06CC\u0646
    \u062F\u0627\u0646\u0634\u06AF\u0627\u0647\u0645\u061F \u0634\u0627\u06CC\u062F
    \u0645\u0646 \u06CC\u0647 \u067E\u0631\u0646\u062F\u0647 \u0628\u0627\u0634\u0645.
    \u062F\u0631 \u0628\u0627\u0632\u0647\u060C\n \u0628\u0627\u0632 \u0647\u0645
    \u067E\u0631\u0646\u062F\u0633. \u067E\u0633 \u067E\u0631\u0646\u062F\u0633.
    \u067E\u0633\u2026 \u0645\u0646 \u06AF\u0631\u06AF\u0645.\r\n"
  textOptions:
  - items:
    - "\u0633\u0627\u0645\u0627\u0646\u0647 \u0645\u062F\u0631\u06A9 \u0645\u0646\n\u0631\u0648
      \u062B\u0628\u062A \u06A9\u0631\u062F\u0647"
    - "\u0645\u0646 \u062F\u0627\u062E\u0644 \u0633\u0627\u0645\u0627\u0646\u0647\n
      \u062B\u0628\u062A \u0646\u0627\u0645 \u06A9\u0631\u062F\u0645"
    - "\u067E\u0633 \u0645\u062F\u0631\u06A9\u06CC\n \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u0647"
  - items:
    - "\u062F\u0627\u0646\u0634\u06AF\u0627\u0647 \u062C\u0627\u06CC\u06CC\u0647
      \u062F\u0631\u0633\n \u06A9\u0627\u0631\u0634\u0646\u0627\u0633\u06CC\u060C 
      \u0627\u0631\u0634\u062F\u060C\n \u062F\u06A9\u062A\u0631\u06CC  \u062A\u062F\u0631\u06CC\u0633
      \u0645\u06CC\u0634\u0647\n"
    - "\u067E\u0633 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647\u0647"
    - "\u0627\u06AF\u0647 \u0627\u06CC\u0646\u062C\u0627 \u062F\u0631\u0633\n \u062A\u062F\u0631\u06CC\u0633
      \u0645\u06CC\u0634\u0647"
  - items:
    - "\u062A\u0648 \u0627\u06CC\u0646\u062C\u0627 \u062A\u062F\u0631\u06CC\u0633\n
      \u0645\u06CC \u06A9\u0646\u06CC"
    - "\u0627\u06AF\u0631 \u06A9\u0633\u06CC \u0627\u06CC\u0646\u062C\u0627\n \u062A\u062F\u0631\u06CC\u0633
      \u0645\u06CC\n \u06A9\u0646\u0647 \u067E\u0633 \u0627\u0633\u062A\u0627\u062F\u0647"
    - "\u062F\u0631 \u0646\u062A\u06CC\u062C\u0647 \u062A\u0648\n \u0627\u0633\u062A\u0627\u062F
      \u0647\u0633\u062A\u06CC"
