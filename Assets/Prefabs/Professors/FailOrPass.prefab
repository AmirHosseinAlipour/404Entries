  m_Text: "\u0633\u0644\u0627\u0645 \u0645\u062A\u0627\u0633\u0641\u0627\u0646\u0647
    \u0634\u0645\u0627 \u062F\u0631 \u062A\u0635\u062D\u06CC\u062D \u062E\u0648\u0628
    \u0639\u0645\u0644 \u06A9\u0631\u062F\u06CC\u062F \u0648\u0644\u06CC \u062E\u0628
    \u0627\u0632 \u0627\u0648\u0646\u062C\u0627\u06CC\u06CC \u06A9\u0647\n \u062E\u0648\u0628
    \u0639\u0645\u0644 \u06A9\u0631\u062F\u06CC\u062F \u0645\u062C\u0628\u0648\u0631\u06CC\u0645
    \u0627\u062E\u0631\u0627\u062C\u062A\u0648\u0646 \u06A9\u0646\u06CC\u0645.\r\n"
