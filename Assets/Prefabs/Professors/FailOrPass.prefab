  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: ed6b7991f701926488cd74aa874cfd2f, type: 3}
    m_FontSize: 32
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 72
    m_Alignment: 2
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u0646\u0627\u0645\u0647 \u0627\u0632 \u0645\u062F\u06CC\u0631\u06CC\u062A:
    \u0633\u0644\u0627\u0645 \u0627\u0633\u062A\u0627\u062F \u0639\u0632\u06CC\u0632
    \u062F\u0642\u062A \u06A9\u0646\u06CC\u0646 \u06A9\u0647 \u0628\u0647 \u062A\u0627\u0632\u06AF\u06CC
    \u0634\u06A9\u0627\u06CC\u062A \u0647\u0627\u06CC \u0632\u06CC\u0627\u062F\u06CC
    \u0627\u0632 \u0634\u0645\u0627 \n\u062A\u0648\u0633\u0637 \u062F\u0627\u0646\u0634\u062C\u0648\u06CC\u0627\u0646
    \u0645\u0637\u0631\u062D \u0634\u062F\u0647 \u062F\u0631 \u062A\u0635\u062D\u06CC\u062D
    \u0647\u0627 \u062F\u0642\u062A \u06A9\u0646\u06CC\u062F \u0648\u06AF\u0631\u0646\u0647
    \u0645\u062C\u0628\u0648\u0631\u06CC\u0645 \u06A9\u0647 \u067E\u0631\u0648\u0646\u062F\u062A\u0627\u0646\n
    \u0631\u0627 \u0628\u0647 \u06A9\u0645\u06CC\u062A\u0647 \u0627\u0646\u0636\u0628\u0627\u0637\u06CC
    \u062A\u062D\u0648\u06CC\u0644 \u0648 \u0628\u0639\u062F \u0627\u062E\u0631\u0627\u062C
    \u0628\u062F\u0647\u06CC\u0645.\r\n"
