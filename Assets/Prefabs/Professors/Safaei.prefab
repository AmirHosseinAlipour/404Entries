  typewriter: {fileID: 6245136270893814086}
  ButtonCanvas: {fileID: 5964882961815193857}
  phaseTexts:
  - "\u062E\u0628 \u062E\u0648\u0634 \u0627\u0648\u0645\u062F\u06CC\u062F \u0628\u0686\u0647
    \u0647\u0627 \u0645\u0627 \u0627\u0648\u0645\u062F\u06CC\u0645 \u062F\u0627\u062E\u0644
    \u0627\u06CC\u0646 \u06A9\u0644\u0627\u0633\n \u062F\u0631\u0645\u0648\u0631\u062F
    discrete mathmatics  \u0635\u062D\u0628\u062A \u06A9\u0646\u06CC\u0645!\n \u062F\u0631\u0633\u062A\u0647
    \u06A9\u0647 \u062C\u0644\u0633\u0647 \u0627\u0648\u0644\u0647 \u0648\u0644\u06CC
    \u0627\u0632 \u0647\u0645\u06CC\u0646 \u0627\u0644\u0627\u0646 \u0639\u0642\u0628\u06CC\u0645\u060C\n
    \u067E\u0633 \u0628\u062F\u0648\u0646 \u0647\u06CC\u0686 waste of time\u06CC\u06CC
    \u0628\u0631\u06CC\u0645 \u0633\u0631 \u062F\u0631\u0633: \r\nsubject \u0627\u06CC\u0646
    \u062C\u0644\u0633\u0647 \u0639\u0644\u0645 logic \u0647\u0633\u062A: \u0639\u0644\u0645
    \u0645\u0646\u0637\u0642\n \u0645\u062C\u0645\u0648\u0639\u0647 \u0627\u06CC
    \u0627\u0632 \u0642\u0648\u0627\u0639\u062F \u0645\u0646\u0637\u0642\u06CC \u0647\u0633\u062A
    \u06A9\u0647 \u0645\u0627 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u062F\u0646\n
    \u062F\u0631\u0645\u0648\u0631\u062F \u0645\u0646\u0637\u0642\u060C \u0645\u0646\u0637\u0642\u06CC
    \u0635\u062D\u0628\u062A \u06A9\u0646\u06CC\u0645.\r\n"
  - "\u0628\u0628\u06CC\u0646\u06CC\u062F \u0639\u0644\u0645 \u0645\u0646\u0637\u0642
    \u0639\u0644\u0645 \u0633\u0627\u062F\u0647 \u0627\u06CC \u0646\u06CC\u0633\u062A\u060C
    \u0645\u062B\u0644\u0627\n \u06CC\u0647 \u0645\u062B\u0627\u0644 \u0628\u0631\u0627\u06CC
    \u0634\u0645\u0627 \u0628\u0632\u0646\u0645: \u0634\u0645\u0627 \u062A\u0627
    \u062D\u0627\u0644\u0627 \u0628\u0647 \u0627\u06CC\u0646\n \u062C\u0645\u0644\u0647
    \u0641\u06A9\u0631 \u06A9\u0631\u062F\u06CC\u062F \u0622\u062F\u0645 \u062D\u06CC\u0648\u0627\u0646
    \u0627\u0633\u062A\u060C \u062F\u0627\u0646\u0634\u062C\u0648\n \u0622\u062F\u0645
    \u0627\u0633\u062A: \u067E\u0633 \u062F\u0627\u0646\u0634\u062C\u0648 \u062D\u06CC\u0648\u0627\u0646
    \u0627\u0633\u062A\u061F \u062E\u0628 \u0627\u06CC\u0646\n \u062C\u0645\u0644\u0647
    \u062E\u06CC\u0644\u06CC \u0646\u06A9\u0627\u062A \u067E\u0646\u0647\u0627\u0646\u06CC
    \u062F\u0627\u062E\u0644\u0634 \u0647\u0633\u062A \u0627\u0644\u0628\u062A\u0647\n
    \u0645\u0646 \u062E\u0648\u062F\u0645 \u062E\u06CC\u0644\u06CC \u062F\u0631 \u0627\u06CC\u0646
    \u0632\u0645\u06CC\u0646\u0647 \u0627\u062F\u0639\u0627\u06CC\u06CC \u0646\u062F\u0627\u0631\u0645\u060C\n
    \u0633\u0631 \u0631\u0634\u062A\u0647 \u0648\u0627\u0642\u0639\u06CC \u062F\u0631
    \u0627\u06CC\u0646 \u0632\u0645\u06CC\u0646\u0647 \u0631\u0648 \u062F\u06A9\u062A\u0631
    \u0645\u0639\n\u0635\u0648\u0645\u06CC \u062F\u0627\u0631\u0646\u062F \u0648\u0644\u06CC
    \u0627\u06AF\u0631 \u062E\u0648\u0627\u0633\u062A\u06CC\u062F \u0628\u06CC\u0627\u06CC\u062F
    \u0628\u0627 \u0647\u0645\n \u062F\u06CC\u06AF\u0647 \u062F\u0631 \u0627\u06CC\u0646
    \u0632\u0645\u06CC\u0646\u0647 \u067E\u06CC\u067E\u0631 \u0645\u06CC \u062F\u06CC\u0645."
  - " paper \u062F\u0627\u062F\u0646 \u0627\u0632 \u0627\u0648\u062C\u0628 \u0648\u0627\u062C\u0628\u0627\u062A
    \u0627\u0633\u062A \u0627\u06AF\u0631 \u062F\u0648\u0633\u062A\n \u062F\u0627\u0634\u062A\u06CC\u062F
    \u0645\u06CC \u062A\u0648\u0646\u06CC\u0645 \u0628\u0627 \u0647\u0645 \u062F\u06CC\u06AF\u0647
    \u06CC\u0647 tea talk \u062F\u0627\u0634\u062A\u0647\n \u0628\u0627\u0634\u06CC\u0645
    \u0648 \u062F\u0631\u0645\u0648\u0631\u062F subject \u0645\u0648\u0631\u062F
    interest \u062A\u0648\u0646\n \u0635\u062D\u0628\u062A \u06A9\u0646\u06CC\u0645
    \u0647\u0645\u06CC\u0646  \u0686\u0646\u062F \u0648\u0642\u062A \u067E\u06CC\u0634
    \u0628\u0648\u062F \u06CC\u0647\n \u0646\u0641\u0631 \u0627\u0648\u0645\u062F
    \u067E\u06CC\u0634\u0645 tea talk \u06A9\u0646\u06CC\u0645 \u0648\u0633\u0637
    \u0635\u062D\u0628\u062A\u0645\u0648\u0646\n \u0628\u0648\u062F \u06A9\u0647
    \u0645\u062A\u0648\u062C\u0647 \u0634\u062F\u0645 \u062F\u0686\u0627\u0631 \u0627\u0641\u0633\u0631\u062F\u06AF\u06CC
    degree 3 \u0634\u062F\u0647\n \u0648 \u0645\u06CC \u062E\u0648\u0627\u062F sucide
    \u06A9\u0646\u0647\u060C \u0635\u062D\u0628\u062A \u06A9\u0631\u062F\u06CC\u0645
    \u0648 \u0642\u0627\u0646\u0639\u0634\n \u06A9\u0631\u062F\u0645 \u0628\u0647
    \u062C\u0627\u06CC \u062E\u0648\u062F\u06A9\u0634\u06CC \u0628\u0631\u0647 \u062A\u06CC\u0645\u0627\u0631\u0633\u062A\u0627\u0646.
    \u062E\u0628\n that's a win isn't it?"
  - "bale dashtam migoftam kholase be careful\n bashid ke ye vaght ab beheshti( i
    mean\n behestri water for thisnoobs who don't\n undertand fingilish) ro nakohrid
    ke corroput\n mishid. In harf man ro hesabi be gosh\n besparid. Movazeb bashid!"
  - "\u4F60\u6709\u6C92\u6709\u60F3\u904E\u6578\u5B5726\u860A\u542B\u8457\u600E\u6A23\u7684\u529B\u91CF\uFF1F\r\n\r\n\u5728\u53E4\u4EE3\u4F0A\u6717\uFF0C\u6578\u5B5726\u662F\u4E00\u500B\u795E\u8056\u7684\u6578\u5B57\u3002\r\n\r\n\u5728\u5927\u5EAB\u5FB7\u65AF\u5766\u5730\u5340\uFF0C\u4EBA\u5011\u7528\u9019\u500B\u6578\u5B57\u4F86\u8868\n\u9054\u5C0D\u9577\u8F29\u7684\u611F\u6FC0\u4E4B\u60C5\u3002\r\n\r\n\u4F8B\u5982\uFF0C\u7576\u6211\u8AAA\u300CMahan
    Jan\uFF0C\u6211\u737B\u4E0A26\u6735\n\u9BAE\u82B1\u7D66\u4F60\u7684\u9748\u9B42\u300D\u6642\uFF0C\u610F\u601D\u662F\u300C\u89AA\u611B\u7684\n\uFF0C\u6211\u611B\u4F60\u300D\u3002\r\nN\u01D0
    y\u01D2u m\xE9iy\u01D2u xi\u01CEnggu\xF2 sh\xF9z\xEC\r\n"
  phaseOptions:
  - options:
    - "\u0627\u0633\u062A\u0627\u062F \u0645\u06CC\u0634\u0647 \u06CC\u06A9\u0645\u06CC
      \u062F\u0631\u0645\u0648\u0631\u062F\n \u062A\u062C\u0631\u0628\u06CC\u0627\u062A\u062A\u0648\u0646
      \u062F\u0631 \u0645\u0646\u0637\u0642\n \u0635\u062D\u0628\u062A \u06A9\u0646\u06CC\u0646\u061F"
    - "\u0627\u0633\u062A\u0627\u062F \u062E\u0633\u062A\u0647 \u0646\u0628\u0627\u0634\u06CC\u0646\u060C\n
