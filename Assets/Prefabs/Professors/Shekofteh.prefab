    \u0639\u0637\u0641\u060C \u0628\u0647 \u062E\u0648\u062F\u06CC \u062E\u0648\u062F\u060C
    \u0646\u06CC\u0627\u0632\u0645\u0646\u062F \u062A\u0623\u0645\u0644\u060C \u0628\u0631\u0646\u0627\u0645\u0647\u200C\u0631\u06CC\u0632\u06CC
