    \u0627\u062E\u0644\u0627\u0642 \u062D\u0631\u0641\u0647\u200C\u0627\u06CC\u060C
    \u062A\u0648\u0627\u0646\u0627\u06CC\u06CC\u200C\u0647\u0627\u06CC \u0627\u0631\u062A\u0628\u0627\u0637\u06CC
    \u0648 \u062A\u0641\u06A9\u0631 \u0627\u0646\u062A\u0642\u0627\u062F\u06CC \u0646\u06CC\u0632
    \u062A\u0648\u062C\u0647 \u0645\u06CC\u200C\u06AF\u0631\u062F\u062F. \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646\u060C
    \u0628\u0627\u06CC\u062F \u0628\u0647 \u0627\u06CC\u0646 \u0646\u06A9\u062A\u0647
    \u062A\u0648\u062C\u0647 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u06CC\u0645
    \u06A9\u0647 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647\u060C \u0635\u0631\u0641\u0627\u064B
