    \u0628\u0647 \u0627\u0646\u062A\u0642\u0627\u0644 \u062F\u0627\u0646\u0634 \u0648
    \u062A\u062E\u0635\u0635 \u067E\u0631\u062F\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C
