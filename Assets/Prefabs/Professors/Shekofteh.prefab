    \u0628\u0647 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647 \u0646\u0642\u0637\u0647
    \u0639\u0637\u0641\u06CC \u062F\u0631 \u0632\u0646\u062F\u06AF\u06CC \u0647\u0631
