    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0628\u0633\u0645 \u0627\u0644\u0644\u0647 \u0627\u0644\u0631\u062D\u0645\u0646
    \u0627\u0644\u0631\u062D\u06CC\u0645\u060C\n\u062F\u0627\u0646\u0634\u062C\u0648\u06CC\u0627\u0646
    \u0639\u0632\u06CC\u0632\u060C \u0647\u0645\u06A9\u0627\u0631\u0627\u0646 \u0645\u062D\u062A\u0631\u0645\u060C
    \u0627\u0633\u0627\u062A\u06CC\u062F \u0627\u0631\u062C\u0645\u0646\u062F\u060C
    \u0648 \u0627\u0639\u0636\u0627\u06CC \u06AF\u0631\u0627\u0645\u06CC \u062E\u0627\u0646\u0648\u0627\u062F\u0647\u200C\u0647\u0627\u06CC
    \u0645\u062D\u062A\u0631\u0645\u060C\n\n\u0627\u0628\u062A\u062F\u0627 \u0645\u0627\u06CC\u0644\u0645
    \u0627\u0632 \u0641\u0631\u0635\u062A \u067E\u06CC\u0634 \u0622\u0645\u062F\u0647
    \u0628\u0631\u0627\u06CC \u062E\u0648\u0634\u200C\u0622\u0645\u062F\u06AF\u0648\u06CC\u06CC
    \u0628\u0647 \u0634\u0645\u0627 \u0639\u0632\u06CC\u0632\u0627\u0646\u060C \u06A9\u0647
    \u0627\u0645\u0631\u0648\u0632 \u0628\u0647 \u062C\u0645\u0639 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647
    \u0645\u0627 \u067E\u06CC\u0648\u0633\u062A\u0647\u200C\u0627\u06CC\u062F\u060C
    \u0646\u0647\u0627\u06CC\u062A \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0631\u0627
    \u0628\u0628\u0631\u0645 \u0648 \u0627\u0632 \u0647\u0645\u0647 \u0634\u0645\u0627
    \u0628\u0627\u0628\u062A \u062D\u0636\u0648\u0631 \u062F\u0631 \u0627\u06CC\u0646
    \u0645\u0631\u0627\u0633\u0645 \u0633\u067E\u0627\u0633\u06AF\u0632\u0627\u0631\u06CC
    \u0646\u0645\u0627\u06CC\u0645. \u062D\u0636\u0648\u0631 \u0634\u0645\u0627 \u062F\u0631
    \u0627\u06CC\u0646 \u062C\u0645\u0639\u060C \u0646\u0647 \u062A\u0646\u0647\u0627
    \u0645\u0627\u06CC\u0647 \u0627\u0641\u062A\u062E\u0627\u0631 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647
    \u0627\u0633\u062A\u060C \u0628\u0644\u06A9\u0647 \u0646\u0634\u0627\u0646\u200C\u062F\u0647\u0646\u062F\u0647
    \u0627\u0646\u06AF\u06CC\u0632\u0647 \u0648 \u0639\u0644\u0627\u0642\u0647\u200C\u0645\u0646\u062F\u06CC
    \u0634\u0645\u0627 \u0628\u0647 \u062A\u062D\u0635\u06CC\u0644 \u0648 \u06A9\u0633\u0628
    \u0639\u0644\u0645 \u0648 \u062F\u0627\u0646\u0634 \u062F\u0631 \u0631\u0634\u062A\u0647\u200C\u0647\u0627
    \u0648 \u062D\u0648\u0632\u0647\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641
    \u062F\u0627\u0646\u0634\u06AF\u0627\u0647\u06CC \u0627\u0633\u062A\u060C \u0648
    \u0627\u06CC\u0646 \u0646\u06A9\u062A\u0647\u200C\u0627\u06CC \u0627\u0633\u062A
    \u06A9\u0647 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0627\u0632 \u0622\u0646
    \u0628\u0647 \u0633\u0627\u062F\u06AF\u06CC \u06AF\u0630\u0634\u062A.\n\n\u0647\u0645\u0627\u0646\u200C\u0637\u0648\u0631
    \u06A9\u0647 \u0645\u06CC\u200C\u062F\u0627\u0646\u06CC\u062F\u060C \u0648\u0631\u0648\u062F
    \u0628\u0647 \u062F\u0627\u0646\u0634\u06AF\u0627\u0647 \u0646\u0642\u0637\u0647
    \u0639\u0637\u0641\u06CC \u062F\u0631 \u0632\u0646\u062F\u06AF\u06CC \u0647\u0631
    \u0641\u0631\u062F \u0627\u0633\u062A\u060C \u0648 \u0627\u06CC\u0646 \u0646\u0642\u0637\u0647
    \u0639\u0637\u0641\u060C \u0628\u0647 \u062E\u0648\u062F\u06CC \u062E\u0648\u062F\u060C
    \u0646\u06CC\u0627\u0632\u0645\u0646\u062F \u062A\u0623\u0645\u0644\u060C \u0628\u0631\u0646\u0627\u0645\u0647\u200C\u0631\u06CC\u0632\u06CC
    \u0648 \u062F\u0631\u06A9 \u0639\u0645\u06CC\u0642 \u0627\u0632 \u0645\u0633\u0626\u0648\u0644\u06CC\u062A\u200C\u0647\u0627
